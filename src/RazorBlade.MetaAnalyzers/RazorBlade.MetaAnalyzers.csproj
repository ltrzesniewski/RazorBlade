<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>roslyn4.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworkIdentifier>.NETStandard</TargetFrameworkIdentifier>
    <TargetFrameworkVersion>v2.0</TargetFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="[4.0.1]" PrivateAssets="all" Condition="'$(TargetFramework)' == 'roslyn4.0'" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../RazorBlade.Analyzers/Support/Extensions.cs" Link="Support/%(FileName)%(Extension)" />
    <Compile Include="../RazorBlade.Analyzers/Support/CompilerServices.cs" Link="Support/%(FileName)%(Extension)" />
  </ItemGroup>

</Project>
